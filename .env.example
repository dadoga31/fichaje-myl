# =====================================================================
#  FICHAJE MyL — configuración del PC de la empresa
#  Copie este fichero a `.env` y rellénelo. NO lo suba al repositorio.
# =====================================================================

# --- Base de datos ---------------------------------------------------
# Contraseña del superusuario de PostgreSQL. Solo se usa para crear la
# base de datos y aplicar migraciones; la aplicación NO la utiliza.
POSTGRES_PASSWORD=

# Usuario con el que la aplicación atiende a la plantilla. Está sujeto a la
# RLS y NO puede modificar ni borrar un fichaje, ni siquiera por error.
PGUSER=fichaje_app
PGPASSWORD=

PGDATABASE=fichaje
TZ=Europe/Madrid

# --- Túnel de Cloudflare ---------------------------------------------
# Testigo del túnel. Se obtiene en el panel de Cloudflare Zero Trust,
# en Networks → Tunnels → Create a tunnel → Docker.
# Es un secreto: quien lo tenga puede publicar tráfico como su túnel.
TOKEN_TUNEL=

# --- Copias de seguridad ---------------------------------------------
# Frase con la que se cifran los volcados. Mínimo 16 caracteres.
# GUÁRDELA EN UN GESTOR DE CONTRASEÑAS: sin ella las copias no se pueden
# restaurar, y entonces no son copias de seguridad de nada.
CLAVE_COPIAS=

# Días de volcados que se conservan en el disco local. El registro legal de
# 4 años lo garantiza la base de datos, no este histórico.
DIAS_RETENCION_COPIAS=30
