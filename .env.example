# Credenciales de Supabase.
#
# Sin estas dos variables la aplicación arranca en MODO DEMO, con datos
# ficticios en el navegador. Útil para evaluar la interfaz; NO para uso real:
# la inalterabilidad del registro solo es exigible del lado del servidor.
#
# Copie este fichero a .env.local y rellene los valores de su proyecto.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# La clave `anon` es pública por diseño: quien protege los datos es la
# Row Level Security definida en supabase/migrations/0003_rls.sql.
# NUNCA publique aquí la clave `service_role`: ignora la RLS por completo.
