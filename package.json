{
  "name": "fichaje-myl",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PWA de fichaje y registro de jornada laboral conforme al Art. 34.9 ET y RDL 8/2019",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verificar-entorno.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -b",
    "lint": "tsc -b",
    "build:demo": "node scripts/build-demo.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "dev:demo": "VITE_DEMO=true vite",
    "test:rules": "firebase emulators:exec --project fichaje-myl-test --only firestore 'node test/reglas.test.mjs'"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "date-fns": "^4.4.0",
    "firebase": "^12.19.0",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.31.0",
    "motion": "^13.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "firebase-admin": "^14.4.0",
    "firebase-tools": "^15.30.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
